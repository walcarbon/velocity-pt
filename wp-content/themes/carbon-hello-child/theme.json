{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "name": "Primary", "slug": "primary", "color": "#75161C" },
        { "name": "Secondary", "slug": "secondary", "color": "#380002" },
        { "name": "Tertiary", "slug": "tertiary", "color": "#323232" },
        { "name": "Background", "slug": "background", "color": "#FFFFFF" },
        { "name": "Text", "slug": "text", "color": "#1F1F1F" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "name": "System",
          "slug": "system",
          "fontFamily": "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif"
        }
      ],
      "fontSizes": [
        { "name": "H1", "slug": "h1", "size": "clamp(2rem, 5vw, 3rem)" },
        { "name": "H2", "slug": "h2", "size": "clamp(1.75rem, 4vw, 2.5rem)" },
        { "name": "H3", "slug": "h3", "size": "clamp(1.5rem, 3vw, 2rem)" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "name": "XS", "slug": "xs", "size": "0.5rem" },
        { "name": "S", "slug": "s", "size": "1rem" },
        { "name": "M", "slug": "m", "size": "1.5rem" },
        { "name": "L", "slug": "l", "size": "2rem" },
        { "name": "XL", "slug": "xl", "size": "3rem" }
      ]
    }
  }
}
